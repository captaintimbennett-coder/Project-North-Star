{
  "name": "project-north-star",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "payload:generate-types": "payload generate:types",
    "payload:migrate": "payload migrate",
    "payload:migrate:guarded": "node scripts/guarded-payload-migrate.mjs",
    "mission:06:validate": "node scripts/mission-06-validation.mjs",
    "mission:09:availability": "node --experimental-strip-types --test scripts/mission-09-availability.test.mjs",
    "mission:09:booking": "PAYLOAD_MIGRATING=true tsx --env-file=.env scripts/mission-09-booking-validation.ts",
    "mission:09:concurrency": "PAYLOAD_MIGRATING=true tsx --env-file=.env scripts/mission-09-concurrency-validation.ts",
    "mission:09:email": "PAYLOAD_MIGRATING=true tsx --env-file=.env scripts/mission-09-email-validation.ts",
    "mission:09:model-availability": "pnpm mission:09:availability && MISSION_09_VALIDATE_MODEL_AVAILABILITY=true pnpm mission:09:booking",
    "mission:09:personal-schedule": "tsx --test scripts/mission-09-personal-schedule.test.ts",
    "mission:09:shared-schedule": "tsx --test scripts/mission-09-shared-retreat-schedule.test.ts",
    "mission:09:photographer-booking": "tsx --test scripts/mission-09-photographer-booking.test.ts && MISSION_09_VALIDATE_PHOTOGRAPHER_BOOKING=true pnpm mission:09:booking"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@payloadcms/storage-vercel-blob": "3.85.2",
    "@payloadcms/ui": "3.85.2",
    "@vercel/blob": "2.3.1",
    "graphql": "^16.14.2",
    "next": "15.4.11",
    "payload": "3.85.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.4.11",
    "tsx": "4.22.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1"
}
